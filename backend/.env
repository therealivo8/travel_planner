# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (Docker):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/travel_planner
# Dev container:
# DATABASE_URL=postgresql+asyncpg://node:postgres@127.0.0.1:5433/travel_planner
# Railway (auto-injected when you add a Postgres plugin — copy the value from Railway dashboard):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>.railway.app:5432/railway

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random value for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Production (add your Vercel URL — found in Vercel dashboard after first deploy):
# CORS_ORIGINS=https://your-app.vercel.app,https://yourcustomdomain.com

# ── Maps ──────────────────────────────────────────────────────────────────────
# Google Maps Platform key — server-side only (no HTTP referrer restrictions).
# Create at: https://console.cloud.google.com/google/maps-apis/credentials
# Enable: Routes API, Geocoding API, Places API
MAPS_API_KEY=
