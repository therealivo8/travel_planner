# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (Docker):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/travel_planner
# Dev container:
# DATABASE_URL=postgresql+asyncpg://node:postgres@127.0.0.1:5433/travel_planner
# Railway (auto-injected when you add a Postgres plugin — copy the value from Railway dashboard):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>.railway.app:5432/railway

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random value for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Production (add your Vercel URL — found in Vercel dashboard after first deploy):
# CORS_ORIGINS=https://your-app.vercel.app,https://yourcustomdomain.com

# ── Maps / Places / Distance Matrix (Google) ──────────────────────────────────
# Server-side key — do NOT restrict by HTTP referrer; restrict by IP or leave
# unrestricted for local dev. Enable these APIs in the GCP console:
#   - Directions API          (point-to-point route calculation)
#   - Places API              (Nearby Search for radius mode POI discovery)
#   - Distance Matrix API     (drive-time confirmation filter for radius mode)
#   - Geocoding API           (address → lat/lng proxy endpoint)
MAPS_API_KEY=your_server_side_maps_key_here

# ── OpenRouteService (ORS) ────────────────────────────────────────────────────
# Used for drive-time isochrone polygons in Radius Explorer mode.
# Free tier: 500 requests/day, 40 requests/minute.
# Sign up at https://openrouteservice.org → Dashboard → API Keys
ORS_API_KEY=your_ors_api_key_here
