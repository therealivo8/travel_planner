{
  "name": "Travel Planner",
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.override.yml", "docker-compose.devcontainer.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000, 8000, 5432, 8080],
  "portsAttributes": {
    "3000": { "label": "Frontend" },
    "8000": { "label": "Backend API" },
    "5432": { "label": "PostgreSQL" },
    "8080": { "label": "Adminer" }
  },
  "postCreateCommand": "cd /workspace/backend && uv sync && uv run alembic upgrade head",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/backend/.venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
