# Copy to .env.local for local development.
#
# Production values are NOT kept in a file — they live in Vercel's dashboard
# under Settings → Environment Variables. Never commit real keys here.

# ── API ───────────────────────────────────────────────────────────────────────
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (set this in Vercel, not here):
# NEXT_PUBLIC_API_URL=https://travelplanner-production-c840.up.railway.app

# ── Maps (Google) ─────────────────────────────────────────────────────────────
# Client-side key — safe to expose in the browser. Restrict by HTTP referrer
# in the GCP console to prevent unauthorized use.
# Enable these APIs in GCP:
#   - Maps JavaScript API     (map rendering in the browser)
#   - Places API (New)        (address autocomplete in the trip creation form)
# Note: Directions API, Distance Matrix, and Geocoding calls are made
# server-side via MAPS_API_KEY in backend/.env — not this key.
NEXT_PUBLIC_MAPS_API_KEY=your_client_side_maps_key_here

# ── Sentry (error tracking) ─────────────────────────────────────────────────
# Optional — leave unset to disable Sentry entirely (local dev default).
# Get a DSN from https://sentry.io → Project Settings → Client Keys (DSN).
# Sentry DSNs are safe to expose in the browser (write-only, rate-limited by
# project) — see docs/security-alerting.md.
NEXT_PUBLIC_SENTRY_DSN=
